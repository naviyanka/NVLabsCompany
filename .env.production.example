# ==============================================================================
# NEXUS Enterprise Production Environment Configuration Template
# ==============================================================================

# Core Database Configuration
POSTGRES_DB=nexus
POSTGRES_USER=nexus
POSTGRES_PASSWORD=replace_with_secure_production_password
DATABASE_URL=postgresql+asyncpg://nexus:replace_with_secure_production_password@postgres:5432/nexus

# Redis Configuration
REDIS_URL=redis://:replace_with_secure_redis_password@redis:6379/0
REDIS_PASSWORD=replace_with_secure_redis_password

# Application Security
SECRET_KEY=generate_high_entropy_32_byte_secret_key
AUTH_ENABLED=true
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=lax
CORS_ORIGINS=https://nexus.nvlabs.company,https://app.nvlabs.company

# Temporal Workflow Engine
USE_TEMPORAL=true
TEMPORAL_HOST=temporal:7233
TEMPORAL_NAMESPACE=default

# Observability & Monitoring
LOG_LEVEL=INFO
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318

# Model / Sandbox Providers (Encrypted via Vault / External Secrets in K8s)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
SANDBOX_BACKEND=local
