# ==============================================================================
# NEXUS Enterprise Production Environment Configuration Template
# ==============================================================================

# Core Database Configuration
POSTGRES_DB=nexus
POSTGRES_APP_USER=nexus_app
POSTGRES_APP_PASSWORD=replace_with_secure_app_password
POSTGRES_SYSTEM_USER=nexus_system
POSTGRES_SYSTEM_PASSWORD=replace_with_secure_system_password
DATABASE_URL=postgresql+asyncpg://nexus_app:replace_with_secure_app_password@postgres:5432/nexus
DATABASE_SYSTEM_URL=postgresql+asyncpg://nexus_system:replace_with_secure_system_password@postgres:5432/nexus

# Redis Configuration
REDIS_URL=redis://:replace_with_secure_redis_password@redis:6379/0
REDIS_PASSWORD=replace_with_secure_redis_password

# Application Security
SECRET_KEY=generate_high_entropy_32_byte_secret_key
AUTH_ENABLED=true
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=lax
CORS_ORIGINS=https://nexus.nvlabs.company,https://app.nvlabs.company

# Temporal Workflow Engine
USE_TEMPORAL=true
TEMPORAL_HOST=temporal:7233
TEMPORAL_NAMESPACE=default

# Observability & Monitoring
LOG_LEVEL=INFO
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318

# Model / Sandbox Providers (Encrypted via Vault / External Secrets in K8s)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
SANDBOX_BACKEND=local

# LLM Connections / gateway (WP-22). Connections are user-created records; these
# only tune the feature.
# Hostnames exempt from the SSRF check on connection create (private/internal
# gateway host), comma-separated:
LLM_CONNECTION_HOST_ALLOWLIST=
# Budget fails closed on a ledger outage by default; set true to keep serving
# unmetered during an outage instead:
BUDGET_FAIL_OPEN=false
# Gateway model-discovery cache TTL, seconds:
GATEWAY_CATALOG_REFRESH_SECONDS=900
