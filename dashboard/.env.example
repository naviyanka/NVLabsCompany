# Dashboard environment. Copy to `.env.local` and edit; every value below is a default.

# ── Auth ──────────────────────────────────────────────────────────────────────
# Set to "false" only for local UI work without a backend. The dashboard then
# sends X-Company-Id instead of relying on a session, which the API accepts only
# while it is started with AUTH_ENABLED=false. Never ship this as false.
VITE_AUTH_ENABLED=true

# ── API location ──────────────────────────────────────────────────────────────
# Empty means same-origin: requests go to this dev server, which serves the mock
# API and proxies /api/v1/auth/* to NEXUS_API_URL below.
# Point it at the real API (e.g. http://localhost:8000) to bypass the proxy —
# that backend must then list this origin in its cors_origins allowlist, because
# cookies are only sent cross-origin with credentials plus an explicit allow.
VITE_API_BASE_URL=

# ── Dev server (server.ts, not the browser) ───────────────────────────────────
# Where the Express dev server forwards auth calls.
NEXUS_API_URL=http://localhost:8000

# Set to "true" to forward *every* /api/* call to NEXUS_API_URL and disable the
# in-memory mock API entirely.
PROXY_API=false
