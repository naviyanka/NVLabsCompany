# System runtime only (docker-compose.prod.yml, service "system-runtime").
# This is the only file that may hold the BYPASSRLS nexus_system credential. Never load it
# into the API or worker, and never copy SYSTEM_DATABASE_URL into .env.production: those
# processes refuse to start if they find it. Use a different password from the application,
# migration and system roles. Provision the roles first: docs/runbooks/database-roles.md
SYSTEM_DATABASE_URL=postgresql+asyncpg://nexus_system:replace_with_secure_system_password@postgres:5432/nexus
# The same application credential the API uses. The runtime does all tenant work through it.
DATABASE_URL=postgresql+asyncpg://nexus_app:replace_with_secure_app_password@postgres:5432/nexus
REDIS_URL=redis://:replace_with_secure_redis_password@redis:6379/0
