{"nodes": [{"id": "src_nexus_templates_agents_qa_engineer_role", "label": "QA Engineer Agent Role", "file_type": "concept", "source_file": "src/nexus/templates/agents/qa-engineer.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Quality gates must be automated and thorough since there is no manual testing phase."}, {"id": "src_nexus_templates_agents_qa_engineer_test_pyramid", "label": "Test Pyramid (Unit/Integration/E2E)", "file_type": "rationale", "source_file": "src/nexus/templates/agents/qa-engineer.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Many cheap unit tests, fewer expensive end-to-end tests, because E2E maintenance cost scales badly."}, {"id": "src_nexus_templates_agents_qa_engineer_edge_case_generation", "label": "Systematic Edge Case Generation", "file_type": "rationale", "source_file": "src/nexus/templates/agents/qa-engineer.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Empty, boundary, invalid-type, malicious, concurrent, and state-transition inputs are enumerated for every input."}, {"id": "src_nexus_templates_agents_qa_engineer_regression_test_first", "label": "Regression Test Before Fix (Red then Green)", "file_type": "rationale", "source_file": "src/nexus/templates/agents/qa-engineer.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Writing the failing test first proves the bug is understood and prevents recurrence."}, {"id": "src_nexus_templates_agents_qa_engineer_flaky_tests_are_bugs", "label": "Flaky Tests Are Bugs", "file_type": "rationale", "source_file": "src/nexus/templates/agents/qa-engineer.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fix or delete, never skip - a skipped