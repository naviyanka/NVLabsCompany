{"nodes": [{"id": "dashboard_readme_nexus_dashboard", "label": "NEXUS Dashboard Application", "file_type": "document", "source_file": "dashboard/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "React, TypeScript, Vite, and Tailwind SPA giving real-time visibility into agents, tasks, budgets, workflows, and organizational evolution."}, {"id": "dashboard_readme_technology_stack", "label": "Dashboard Technology Stack", "file_type": "concept", "source_file": "dashboard/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "React 19, TypeScript 5, Vite 6, Tailwind 4, React Router v7, Recharts, Lucide React."}, {"id": "dashboard_readme_cookie_session_auth", "label": "httpOnly Cookie Session Authentication", "file_type": "concept", "source_file": "dashboard/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The session lives in an httpOnly cookie so JavaScript cannot read the token; every request sends credentials include."}, {"id": "dashboard_readme_csrf_token_header", "label": "X-CSRF-Token Double-Submit Protection", "file_type": "concept", "source_file": "dashboard/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Mutations carry X-CSRF-Token read back from the nv_csrf cookie, the standard defense once auth moves to cookies."}, {"id": "dashboard_readme_require_auth_guard", "label": "RequireAuth Route Guard", "file_type": "concept", "source_file": "dashboard/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Wraps routes and redirects signed-out visitors to /login, or to /setup on a fresh install where the first administrator is created."}, {"id": "dashboard_readme_auth_disabled_mode", "label": "VITE_AUTH_ENABLED false Offline Mode", "file_type": "concept", "source_file": "dashboard/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Falls back to an X-Company-Id header instead of a session; only valid against an API started with AUTH_ENABLED false and explicitly never for deployment."}, {"id": "dashboard_readme_api_base_url_proxy", "label": "API Base URL and Dev Proxy", "file_type": "concept", "source_file": "dashboard/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An empty VITE_API_BASE_URL means same-origin through the mock dev server; PROXY_API true forwards every /api/* call to the real backend."}, {"id": "dashboard_readme_cors_credentials_requirement", "label": "Cross-Origin Credential Allowlist Requirement", "file_type": "concept", "source_file": "dashboard/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pointing VITE_API_BASE_URL straight at the API bypasses the proxy, so that origin must appear in the backend cors_origins allowlist - cookies only travel cross-origin with credentials plus an explicit allow."}, {"id": "dashboard_readme_api_client", "label": "Central API Client (src/api/client.ts)", "file_type": "concept", "source_file": "dashboard/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "All API calls funnel through one module handling base URL, error normalization, and JSON parsing."}, {"id": "dashboard_readme_custom_hooks", "label": "Data Fetching Hooks (useApi/usePolling/useAgents)", "file_type": "concept", "source_file": "dashboard/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Standardized loading and error state handling instead of per-component fetch logic."}, {"id": "dashboard_readme_polling_30s", "label": "30-Second Auto-Refresh Polling", "file_type": "concept", "source_file": "dashboard/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The dashboard polls every 30 seconds, configurable in Settings."}, {"id": "dashboard_readme_route_table", "label": "Dashboard Route Table", "file_type": "concept", "source_file": "dashboard/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Routes spanning auth (/login, /setup, /invite) and operations (/agents, /tasks, /approvals, /budgets, /evolution, /workflows, /meetings, /activity, /settings)."}, {"id": "dashboard_readme_design_system", "label": "Dashboard Design System", "file_type": "concept", "source_file": "dashboard/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Indigo primary, Emerald success, Amber warning, Rose danger, 8px spacing grid, Tailwind utility classes."}, {"id": "dashboard_readme_project_structure", "label": "Dashboard Source Layout", "file_type": "concept", "source_file": "dashboard/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "src/api, components split by domain (activity, agents, charts, common, evolution, governance, layout, org, tasks), hooks, pages, types, utils."}], "edges": [{"source": "dashboard_readme_nexus_dashboard", "target": "dashboard_readme_technology_stack", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "dashboard/README.md", "source_location": null, "weight": 1.0}, {"source": "dashboard_readme_nexus_dashboard", "target": "dashboard_readme_cookie_session_auth", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "dashboa